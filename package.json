{
	"name": "monorepo-ssr",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"setup": "bun install",
		"dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
		"build": "npm run build --prefix apps/web && node scripts/bundle-server.mjs",
		"start": "node dist/server.js",
		"lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
		"typecheck": "concurrently --raw \"npm run typecheck --prefix apps/web\""
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"knip": "^6.32.1"
	},
	"workspaces": [
		"apps/*"
	]
}
